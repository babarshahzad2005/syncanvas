{
  "name": "syncanvas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @syncanvas/web dev",
    "build": "pnpm --filter @syncanvas/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check . && pnpm -r typecheck && tsc --noEmit -p e2e && vitest run",
    "e2e": "playwright test",
    "release": "pnpm build && node -e \"require('fs').rmSync('apps/web/dist/syncanvas/.dev.vars',{force:true})\" && pnpm --filter @syncanvas/web exec wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
