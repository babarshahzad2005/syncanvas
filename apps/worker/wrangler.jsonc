{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "syncanvas",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // One Worker serves the app, API, and board rooms (ADR 0004).
  // The Cloudflare Vite plugin in apps/web builds the client into these assets.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // Postgres (Neon main branch) through Hyperdrive (ADR 0003). Locally, Wrangler connects
  // straight to the dev-branch string in apps/web/.env instead.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "543cb55a3bd8459b87653e980538dc19" }],
  // Production values. Local development overrides BETTER_AUTH_URL in .dev.vars.
  "vars": { "BETTER_AUTH_URL": "https://syncanvas.babarshahzad2005.workers.dev" },
  // One BoardRoom per Board, with SQLite storage (ADR 0006).
  // Thumbnails now, images in M5b (ADR 0007). Locally, Wrangler keeps a local copy instead.
  "kv_namespaces": [{ "binding": "ASSETS", "id": "20093e3a52c74c8fba38e14b344b8f7b" }],
  "durable_objects": { "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],
  // The hourly digest and the daily cleanup (M4 ticket 04; src/index.ts scheduled()).
  "triggers": { "crons": ["0 * * * *", "0 3 * * *"] },
  "observability": { "enabled": true }
}
