{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "syncanvas",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // One Worker serves the app, API, and board rooms (ADR 0004).
  // The Cloudflare Vite plugin in apps/web builds the client into these assets.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // Postgres (Neon) through Hyperdrive (ADR 0003). Locally, Wrangler connects straight to the
  // string in apps/web/.env. The real config id is created in M0 ticket 10.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  "vars": { "BETTER_AUTH_URL": "http://localhost:5173" },
  "observability": { "enabled": true }
}
