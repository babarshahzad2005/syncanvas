# Copy to .env (same folder). .env is gitignored. Never paste these values into a chat or commit them.
# The Cloudflare Vite plugin loads CLOUDFLARE_* variables from this folder when you run `pnpm dev`.

# Neon connection string (Neon dashboard → Connect, connection pooling OFF).
# Used as the local stand-in for the Worker's HYPERDRIVE binding.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
